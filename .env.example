# ============ DataPilot AI environment ============
# Copy to .env and fill in what you have. The app runs fully without any
# keys below — Cloudinary and OpenAI are optional enhancers.

# --- Database (optional; SQLite is the default) ---
# DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5432/datapilot

# --- Cloudinary (asset + evidence layer) ---
# When set: demo datasets are uploaded as Cloudinary assets on startup and
# dataset uploads go through signed direct-to-Cloudinary flow.
# When empty: local managed storage keeps everything working offline.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenAI (optional phrasing enhancer ONLY) ---
# DataPilot's intent extraction, planning, and analysis are its own
# deterministic engine. If a key is present, the LLM may refine intent on
# ambiguous queries and polish insight phrasing. Numbers always come from
# the deterministic engine, never the LLM.
OPENAI_API_KEY=

# --- CORS (optional) ---
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
